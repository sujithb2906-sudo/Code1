def insertion_sort(a):
    for i in range(1, len(a)):
        key = a[i]
        j = i - 1
        swap= False

        while j >= 0 and a[j] > key:
            a[j + 1] = a[j]
            j = j - 1
            swap = True

    if swap==False:
        break



    a[j + 1] = key


a = list(map(int, input("Enter numbers: ").split(",")))

insertion_sort(a)

print("Sorted=",a)
